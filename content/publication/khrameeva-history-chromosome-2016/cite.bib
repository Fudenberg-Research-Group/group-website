@article{khrameeva_history_chromosome_2016,
 title = {History of chromosome rearrangements reflects the spatial organization of yeast chromosomes},
 author = {Ekaterina E Khrameeva and Geoffrey Fudenberg and Mikhail S Gelfand and Leonid A Mirny},
 journal = {Journal of bioinformatics and computational biology},
 volume = {14},
 number = {02},
 pages = {1641002},
