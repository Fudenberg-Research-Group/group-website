 year = {2025},
 doi = {10.1101/2025.10.17.682904},
 url = {https://www.biorxiv.org/content/10.1101/2025.10.17.682904.abstract},
 abstract = {The spatial folding of the genome shapes gene regulation by controlling which loci interact, yet inferring the mechanisms behind these 3D structures from contact maps remains difficult. Cohesin-mediated loop extrusion is a key organizer of domains and loops, but existing methods either predict contacts without mechanistic insight or simulate extrusion with limited scalability.}
